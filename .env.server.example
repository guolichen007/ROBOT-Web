APP_ENV=server
APP_NAME=Firebot Cloud Control Platform
DATABASE_URL_FILE=/run/secrets/database_url
REDIS_URL_FILE=/run/secrets/redis_url
POSTGRES_DB=firebot
POSTGRES_USER=firebot
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
REDIS_PASSWORD_FILE=/run/secrets/redis_password
MQTT_HOST=mosquitto
MQTT_PORT=8883
SERVER_HTTP_PORT=80
SERVER_HTTPS_PORT=443
MQTT_ALLOW_ANONYMOUS=false
MQTT_USERNAME=platform
MQTT_PASSWORD_FILE=/run/secrets/mqtt_platform_password
MQTT_TLS=true
MQTT_CA_FILE=/run/secrets/mqtt_ca
JWT_SECRET_FILE=/run/secrets/jwt_secret
REFRESH_SECRET_FILE=/run/secrets/refresh_secret
CSRF_SECRET_FILE=/run/secrets/csrf_secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
MEDIA_PUBLISH_TOKEN_FILE=/run/secrets/media_publish_token
COOKIE_SECURE=true
ENABLE_API_DOCS=false
ALLOWED_ORIGINS=https://firebot-server.example.invalid
PUBLIC_BASE_URL=https://firebot-server.example.invalid
MEDIAMTX_WEBRTC_ALLOW_ORIGINS=https://firebot-server.example.invalid
SEED_DEMO=false
MOCK_ENABLED=false
LOG_LEVEL=INFO
ASSET_ROOT=/data/assets
TELEMETRY_RETENTION_DAYS=30
SENSOR_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
MANUAL_LEASE_TTL_SECONDS=5
COMMAND_ACK_TIMEOUT_SECONDS=3
EVENT_STREAM_MAXLEN=10000
ROBOT_STALE_SECONDS=3
ROBOT_OFFLINE_SECONDS=10
MAX_MQTT_PAYLOAD_BYTES=262144
MAX_JSON_DEPTH=20
MQTT_RATE_LIMIT_PER_SECOND=50
MQTT_LOCATION_RATE_LIMIT_PER_SECOND=30
ROS_COMPAT_MODE=false
SINGLE_ROBOT_MODE=true
SINGLE_ROBOT_INTERNAL_ID=R001
ROS_COMPAT_EXPECTED_EXTERNAL_ID=
ROS_COMPAT_RAW_MAX_BYTES=16384
ROS_COMPAT_RAW_RETENTION_SECONDS=900
ROS_COMPAT_STALE_SECONDS=8
ROS_COMPAT_OFFLINE_SECONDS=15
ROS_COMPAT_POSE_MAX_AGE_SECONDS=2
ROS_COMPAT_HEARTBEAT_MAX_AGE_SECONDS=8
ROS_COMPAT_MAX_FUTURE_SKEW_SECONDS=2
ROS_COMPAT_METADATA_REFRESH_SECONDS=60
ROS_COMPAT_WS_MAX_HZ=10
