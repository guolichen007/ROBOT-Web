# G2 三侧一致配置（API / Dispatcher / 专属 Adapter 读取同一份值）；不入库，root:600。
# 仅 001 获得诊断 + ROS 软件测试；002 及其它车辆不在任何列表中（行为不变）。
G2_DOWNLINK_ENABLED=true
G2_DOWNLINK_ALLOWLIST=firebot-vehicle-01
G2_VEHICLE_TRANSPORT_PROFILES=firebot-vehicle-01=r001-independent-v1
# 专属 Adapter 实例 ID（compose 中 FIREBOT_SERVICE_INSTANCE_ID 与此处必须相同）
R001_ADAPTER_INSTANCE_ID=r001-dedicated-adapter-v2
G2_TRANSPORT_PROFILE_ADAPTERS=r001-independent-v1=r001-dedicated-adapter-v2
G2_VEHICLE_EXECUTION_PROFILES=firebot-vehicle-01=ros-software-test
# 仅专属 Adapter 使用：本实例服务的 profile
G2_R001_TRANSPORT_PROFILE=r001-independent-v1
# Dispatcher 独立 Broker 描述文件（宿主路径）与 r001 网络名
G2_DISPATCHER_PROFILES_JSON=/srv/u-dao/projects/firebot/runtime/g2/dispatcher-broker-profiles.json
R001_NETWORK=u-dao-firebot-r001-prod_r001
# 五服务镜像（同一 G2 批准 SHA；<SHA> 由发布记录填写，禁止 latest）。
# 注意：绝不在此设置 FIREBOT_PYTHON_IMAGE / FIREBOT_WEB_IMAGE——那会改变 002 链路服务的展开配置。
G2_PYTHON_IMAGE=firebot-python:g2-<SHA>
G2_WEB_IMAGE=firebot-web:g2-<SHA>
R001_ADAPTER_IMAGE=firebot-python:g2-<SHA>
R001_INGRESS_IMAGE=firebot-python:g2-<SHA>
