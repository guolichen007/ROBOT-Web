# firebot 车端视频发布器配置模板（非敏感；不含任何凭证/密钥/token）
# 安装：cp 至 /etc/firebot/video/env，chown root:firebot-video，chmod 0640
# 凭证文件（另行受控投递，0640 root:firebot-video，值绝不回显）：
#   实测修正：0600 root:firebot-video 时 firebot-video 用户不可读（0600 属主
#   root 仅 root 可读），必须 0640 root:firebot-video 或 0600 firebot-video:firebot-video。
#   /etc/firebot/video/srt_passphrase   SRT 加密 passphrase（与发布鉴权 token 严格分离）
#   /etc/firebot/video/srt_streamid     streamid=publish:<path>:<user>:<pass>（token 在 pass 字段）

# ---- RGB（双目 USB UVC，左右拼接；同型车标准 1280x480@30） ----
RGB_DEV=/dev/video0
RGB_WIDTH=1280
RGB_HEIGHT=480
RGB_FPS=30
RGB_PIXFMT=mjpeg
RGB_SRT_HOST=<云端 SRT 公网 host，待交付>
RGB_SRT_PORT=8890
RGB_UDP_PORT=8891
# RGB_RTSP_URL=<若相机为 RTSP 网络相机则填 url:port/path，并注释掉上面的 UVC 参数>

# ---- THERMAL（SV USB UVC 机芯） ----
THERMAL_DEV=/dev/video1
THERMAL_WIDTH=640
THERMAL_HEIGHT=480
THERMAL_FPS=25
THERMAL_PIXFMT=yuyv422
THERMAL_SRT_HOST=<云端 SRT 公网 host，待交付>
THERMAL_SRT_PORT=8890
THERMAL_UDP_PORT=8892
# THERMAL_RTSP_URL=<若热成像为 RTSP 网络相机则填 url:port/path>
