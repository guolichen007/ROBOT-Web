# firebot-001 真实 RGB 相机 SRT 发布（独立进程；与 thermal 互不影响）
# 相机离线/SRT 断开 → 进程退出 → 有界退避重启；凭证经 0600 文件 → env，不进 argv。
[Unit]
Description=Firebot vehicle video publisher: real RGB camera -> SRT (NO_HARDWARE, camera only)
Wants=network-online.target
After=network-online.target
# 有界退避：300 秒内最多 6 次启动，超过进入 failed（需人工介入，避免无限高频重启）
StartLimitIntervalSec=300s
StartLimitBurst=6

[Service]
Type=simple
User=firebot-video
Group=firebot-video
EnvironmentFile=/etc/firebot/video/env
ExecStart=/opt/firebot/vehicle-video/firebot_video_publisher.sh rgb
Restart=on-failure
RestartSec=10s
# 日志限额：30 秒窗口最多 200 条，防 ffmpeg 刷屏
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
