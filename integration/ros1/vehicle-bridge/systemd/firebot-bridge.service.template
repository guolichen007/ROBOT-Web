[Unit]
Description=Firebot vehicle ROS bridge (communication layer, schema 1.3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash @INSTALL_DIR@/run_bridge.sh @INSTALL_DIR@/config/bridge.env
Restart=always
RestartSec=5
User=@BRIDGE_USER@
Environment=PYTHONUNBUFFERED=1
Environment=FIREBOT_ROS_SETUP=@ROS_SETUP@
Environment=FIREBOT_ROS_WORKSPACE_SETUP=@ROS_WORKSPACE_SETUP@
# 密码经 EnvironmentFile 注入（root:root 600），不写进本文件、不进 Git
EnvironmentFile=-/etc/firebot/bridge-secret.env

[Install]
WantedBy=multi-user.target
