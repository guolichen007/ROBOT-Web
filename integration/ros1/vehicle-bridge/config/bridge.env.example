# Firebot 车端 Bridge 配置【参考模板，非生产配置】
#
# 生产 /etc/firebot/bridge.env 由 `firebotctl vehicle enroll` 生成，标记 GENERATED - DO NOT EDIT。
# 本文件只是字段参考，绝不作为生产默认身份；不要手填 vehicle id / MQTT username。

# ---- MQTT ----
FIREBOT_MQTT_HOST=
FIREBOT_MQTT_PORT=8883
FIREBOT_MQTT_USERNAME=
FIREBOT_CA_CERT=/etc/firebot/production-ca.crt

# ---- 身份 / 地图 ----
# 设备身份缺失时 Bridge 启动直接 fail（无危险默认）；由 device.env / enrollment 写入。
FIREBOT_VEHICLE_ID=
FIREBOT_SITE_CODE=
FIREBOT_MAP_CODE=
FIREBOT_MAP_VERSION=
FIREBOT_MAP_CHECKSUM=
FIREBOT_LOCATION_ENABLED=false

# ---- 上报频率 ----
FIREBOT_HEARTBEAT_HZ=1
FIREBOT_STATUS_HZ=1
FIREBOT_LOCATION_MAX_HZ=10

# ---- 控制占位语义 ----
BRIDGE_STUB_MODE=false
FIREBOT_FEEDBACK_TIMEOUT_SECONDS=3
BRIDGE_STUB_SIMULATE_FEEDBACK=true
BRIDGE_STUB_FEEDBACK_SIMULATION=rejected

# ---- 能力声明（唯一权威 = 真实可接受执行的能力）----
# 由 firebotctl vehicle capability <stop-only|patrol> 管理，禁止手改。
FIREBOT_SUPPORTED_COMMANDS=
FIREBOT_SENSORS=
FIREBOT_MEDIA=
FIREBOT_PROTOCOL_VERSION=1.3.0

# ---- 现场通信链路追踪（纯 observability）----
FIREBOT_FIELD_TRACE=false
