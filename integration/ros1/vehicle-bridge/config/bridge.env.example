# Firebot 车端 Bridge 配置模板
# 由 install.sh 复制为 /etc/firebot/bridge.env。密码不写此文件（systemd EnvironmentFile：/etc/firebot/bridge-secret.env）。

# ---- MQTT ----
FIREBOT_MQTT_HOST=100.110.31.112
FIREBOT_MQTT_PORT=8883
FIREBOT_MQTT_USERNAME=firebot-vehicle-01
FIREBOT_CA_CERT=/etc/firebot/production-ca.crt

# ---- 身份 / 地图 ----
# 地图身份必须显式配置（不设危险默认值）；location 默认关闭，身份确认后才开
FIREBOT_VEHICLE_ID=firebot-vehicle-01
FIREBOT_SITE_CODE=
FIREBOT_MAP_CODE=
FIREBOT_MAP_VERSION=
FIREBOT_MAP_CHECKSUM=
FIREBOT_LOCATION_ENABLED=false

# ---- 上报频率 ----
FIREBOT_HEARTBEAT_HZ=1
FIREBOT_STATUS_HZ=1
# sensor 与 status 同频发布（status_hz）；无独立 SENSOR_HZ
FIREBOT_LOCATION_MAX_HZ=10

# ---- 控制占位语义 ----
# false=生产（命令只转发 ROS placeholder，无 feedback 回 rejected/BRIDGE_ADAPTER_NOT_CONNECTED）
# true=联调（临时声明测试命令、模拟 feedback）
BRIDGE_STUB_MODE=false
FIREBOT_FEEDBACK_TIMEOUT_SECONDS=3
BRIDGE_STUB_SIMULATE_FEEDBACK=true
BRIDGE_STUB_FEEDBACK_SIMULATION=rejected

# ---- 能力声明（唯一权威 = 真实可接受执行的能力）----
# 生产默认空（未接 ROS 不声明 supported）；联调可临时：patrol
FIREBOT_SUPPORTED_COMMANDS=
# 真实传感器（唯一权威）。有 smoke 真实源才声明 smoke；没有则留空（Bridge 不发布 sensor）
FIREBOT_SENSORS=
FIREBOT_MEDIA=
FIREBOT_PROTOCOL_VERSION=1.3.0
