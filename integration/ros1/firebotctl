#!/usr/bin/env bash
# firebotctl — Firebot 现场唯一统一入口（Fleet 产品化）
#
# 现场只使用本入口；底层模块脚本（vehicle-install.sh / vehicle-runtime.sh / server-deploy.sh 等）
# 保留为 module implementation，不要求现场人员理解。
#
# 车端：
#   firebotctl vehicle enroll <DEVICE_ID>            # 生成 device.env + GENERATED bridge.env
#   firebotctl vehicle install --sha <SHA>           # 安装 Bridge + Control（不启动控制）
#   firebotctl vehicle verify                         # 机器可读验收（含 Control active 只读安全门）
#   firebotctl vehicle status                         # 只读状态
#   firebotctl vehicle start base|navigation|control  # 模块化启动
#   firebotctl vehicle stop control                   # 只停 control
#   firebotctl vehicle capability stop-only|patrol    # 受控能力提升（自动重启 Bridge）
#   firebotctl vehicle location enable                # 受控开启 location（先验地图/AMCL/odom）
#   firebotctl vehicle media-secret check             # 媒体 secret 落盘规范检查（值不回显）
#   firebotctl vehicle profile-sync                   # 从 profile 重新生成 bridge.env
#   firebotctl vehicle support-bundle                 # 脱敏诊断包
#   firebotctl vehicle rollback                       # 回滚 previous
#   firebotctl vehicle upgrade --sha <SHA>            # 升级
#   firebotctl vehicle readonly-preflight             # 真实车辆只读接入前置检查（bootstrap/enrolled）
#   firebotctl vehicle readonly-start                 # 只读启动 Bridge（唯一正式入口）
#   firebotctl vehicle migration-stop-legacy           # 跨 Broker 迁移 cutover 切换点（停 legacy Bridge）
#   firebotctl vehicle edge-backup-legacy                # Stage A legacy 备份（Edge Home backups/legacy/；零运行影响）
# 服务器：
#   firebotctl server deploy --sha <SHA>              # 一条命令部署
#   firebotctl server verify / rollback / support-bundle
# 舰队：
#   firebotctl fleet register <DEVICE_ID>             # 生成 per-device credential + enrollment token
#   firebotctl fleet sites                             # 只读列出 Site
#   firebotctl fleet preregister <DEVICE_ID>          # 建立 Fleet stable identity（只读基线）
#   firebotctl fleet status
set -euo pipefail

# 用真实路径（resolve symlink），保证从任意 cwd / /usr/local/bin 符号链接都能正确定位 ROBOT-Web 根。
# SCRIPT_DIR = ROBOT-Web/integration/ros1（firebotctl 所在目录），因此 REPO_DIR 需上两级到 ROBOT-Web。
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
ROS1_DIR="$SCRIPT_DIR"
PROFILE_DIR="$ROS1_DIR/profiles"
# 车端固定环境根（测试可经 FIREBOT_TEST_ETC_ROOT 注入 fixture；生产默认 /etc/firebot）
FIREBOT_ETC="${FIREBOT_TEST_ETC_ROOT:-/etc/firebot}"
export FIREBOT_ETC
DEVICE_ENV="$FIREBOT_ETC/device.env"
BRIDGE_ENV="$FIREBOT_ETC/bridge.env"
BRIDGE_SECRET="$FIREBOT_ETC/bridge-secret.env"
DEFAULT_PROFILE="firebot_ros1_standard_v1"
BOOTSTRAP_ENV="$FIREBOT_ETC/bootstrap.env"
# 允许测试注入 fixture 命令（生产调用不设置，走真实命令）。
SYSTEMCTL="${FIREBOT_TEST_SYSTEMCTL:-systemctl}"
CURL="${FIREBOT_TEST_CURL:-curl}"

# 服务器 bootstrap 配置（非 secret）：FIREBOT_SERVER_URL=https://<server>
if [ -f "$BOOTSTRAP_ENV" ]; then
  # shellcheck disable=SC1091
  . "$BOOTSTRAP_ENV"
fi
# enrollment 正式入口（Nginx HTTPS API），禁止 http 默认地址、禁止 -k。
ENROLL_URL_DEFAULT="${FIREBOT_SERVER_URL:+${FIREBOT_SERVER_URL%/}/api/v1/enrollment/activate}"

DEVICE_TOKEN_FILE="$FIREBOT_ETC/device-token"

device_token_value() { cat "$DEVICE_TOKEN_FILE" 2>/dev/null || true; }

server_base_url() { echo "${FIREBOT_SERVER_URL%/}"; }

server_get_assignment() {
  local did="$1"
  # HTTPS 信任 = Ubuntu 系统 CA store（正式 API 使用 TrustAsia 公网证书）；禁止 --cacert / -k
  curl -sf \
    -H "X-Device-Token: $(device_token_value)" \
    "$(server_base_url)/api/v1/robots/$did/assignment/device" 2>/dev/null || true
}

server_put_assignment() {
  local did="$1" path="$2" json_body="$3"
  # 同上：系统 CA，无 --cacert / -k
  curl -sf \
    -X PUT -H "Content-Type: application/json" -H "X-Device-Token: $(device_token_value)" \
    -d "$json_body" \
    "$(server_base_url)/api/v1/robots/$did/assignment/$path" 2>/dev/null || true
}

require_root() {
  # 测试逃逸：仅 CI fixture（FIREBOT_TEST_SKIP_ROOT=1）；生产必须 root。
  [ "${FIREBOT_TEST_SKIP_ROOT:-0}" = "1" ] && return 0
  [ "$(id -u)" -eq 0 ] || { echo "ERROR: 需要 root（用 sudo）" >&2; exit 1; }
}
require_sha() {
  echo "$1" | grep -qE '^[0-9a-f]{40}$' || { echo "ERROR: SHA 必须是 40 位 hex" >&2; exit 1; }
}

# P0-2/P0-3 公共门：firebot-bridge active/activating/reloading 时禁止 enroll/install。
# fail-closed 语义：Bridge 未停前绝不写配置、绝不消费 token、绝不进入安装。
bridge_active_state() {
  "$SYSTEMCTL" is-active firebot-bridge 2>/dev/null || echo inactive
}
bridge_running() {
  case "$(bridge_active_state)" in
    active|activating|reloading) return 0 ;;
    *) return 1 ;;
  esac
}

# 自动同步批准 SHA：fetch + checkout --detach，禁止 reset/stash/改代码。
# 服务器和车端的 exact-SHA release 均要求完全 clean。
release_sync() {
  local sha="$1" mode="${2:-vehicle}"
  require_sha "$sha"
  local dirty
  dirty="$(git -C "$REPO_DIR" status --porcelain 2>/dev/null)"
  if [ -n "$dirty" ]; then
    echo "ERROR: ROBOT-Web 工作区不干净（含 untracked/staged 变更），禁止自动 checkout" >&2
    exit 1
  fi
  git -C "$REPO_DIR" fetch origin 2>/dev/null || true
  git -C "$REPO_DIR" cat-file -e "$sha^{commit}" 2>/dev/null || {
    echo "ERROR: 目标 SHA $sha 在本地仓库不存在（先 git fetch）" >&2
    exit 1
  }
  git -C "$REPO_DIR" checkout --detach "$sha"
  local head
  head="$(git -C "$REPO_DIR" rev-parse HEAD)"
  [ "$head" = "$sha" ] || { echo "ERROR: HEAD($head) != SHA($sha)" >&2; exit 1; }
}

read_device_id() {
  local did=""
  [ -f "$DEVICE_ENV" ] && did="$(grep -E '^DEVICE_ID=' "$DEVICE_ENV" | tail -1 | cut -d= -f2- | tr -d '"')"
  echo "$did"
}

read_boot_id() {
  local sf="/run/firebot-bridge/status.json"
  [ -f "$sf" ] || sf="/tmp/firebot-bridge-status.json"
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1],encoding="utf-8")); print(d.get("boot_id") or "")' "$sf" 2>/dev/null || true
}

status_bool() {
  local sf="/run/firebot-bridge/status.json"
  [ -f "$sf" ] || sf="/tmp/firebot-bridge-status.json"
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1],encoding="utf-8")); print("true" if d.get(sys.argv[2]) is True else "false")' "$sf" "$1" 2>/dev/null || echo "false"
}

# ---- 生成 bridge.env（GENERATED，来源 device.env + profile + assignment）----
generate_bridge_env() {
  local device_id="$1" profile_id="$2"
  [ -f "$PROFILE_DIR/$profile_id.yaml" ] || { echo "ERROR: profile 不存在: $profile_id" >&2; exit 1; }
  # site/map 由服务器 assignment 提供（/etc/firebot/assignment.env），可选。
  local assignment="${FIREBOT_ASSIGNMENT_FILE:-$FIREBOT_ETC/assignment.env}"
  [ -f "$assignment" ] || assignment=/dev/null
  python3 - "$device_id" "$profile_id" "$PROFILE_DIR/$profile_id.yaml" "$assignment" <<'PY'
import os, sys
device_id, profile_id, profile_path, assignment_path = sys.argv[1:5]
def load_kv(path):
    d = {}
    if os.path.exists(path):
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            d[k.strip()] = v.strip().strip('"').strip("'")
    return d
assignment = load_kv(assignment_path)

# 生产语义：MQTT host 必须来自服务器 assignment（firebot.youdaozd.com）；
# 缺失即失败，绝不 fallback 到 Tailscale/IP（旧 100.110.31.112 默认已废弃）。
if not assignment.get("MQTT_HOST"):
    print("ERROR: assignment 缺少 MQTT_HOST（先 firebotctl vehicle enroll 或 profile-sync）", file=sys.stderr)
    sys.exit(1)

# 轻量 YAML 解析（仅取我们需要的标量键，不引入第三方依赖）
profile = {}
cur = None
for line in open(profile_path, encoding="utf-8"):
    raw = line.rstrip("\n")
    stripped = raw.strip()
    if not stripped or stripped.startswith("#"):
        continue
    indent = len(raw) - len(raw.lstrip(" "))
    if indent == 0 and stripped.endswith(":"):
        cur = stripped[:-1]
        profile[cur] = {}
    elif ":" in stripped and indent == 2:
        k, v = stripped.split(":", 1)
        profile.setdefault(cur, {})[k.strip()] = v.strip()
    elif indent == 4 and ":" in stripped and cur and profile[cur].get(stripped.split(":")[0].strip()) is None:
        # 嵌套（package/launch）忽略到顶层即可；这里简单记录标量
        k, v = stripped.split(":", 1)
        profile.setdefault(cur, {})[k.strip()] = v.strip()

ros = profile.get("ros", {})
base = profile.get("base", {})
bridge = profile.get("bridge", {})
motion = profile.get("motion", {})

lines = [
    "# GENERATED FILE - DO NOT EDIT",
    "# 来源：device.env + fleet profile(%s) + server assignment" % profile_id,
    "# 如需改变 map/site/MQTT host，用 firebotctl vehicle profile-sync 重新生成。",
    "",
    "FIREBOT_VEHICLE_ID=%s" % device_id,
    "FIREBOT_MQTT_USERNAME=%s" % device_id,
    "FIREBOT_MQTT_HOST=%s" % assignment.get("MQTT_HOST", ""),
    "FIREBOT_MQTT_PORT=%s" % assignment.get("MQTT_PORT", "8883"),
    # MQTT 信任锚 = U-Dao private CA（与 HTTPS 系统 CA 严格分离，P0-3）
    "FIREBOT_CA_CERT=/etc/firebot/mqtt-ca.crt",
    "",
    "FIREBOT_SITE_CODE=%s" % assignment.get("SITE_CODE", ""),
    "FIREBOT_MAP_CODE=%s" % assignment.get("MAP_CODE", ""),
    "FIREBOT_MAP_VERSION=%s" % assignment.get("MAP_VERSION", ""),
    "FIREBOT_MAP_CHECKSUM=%s" % assignment.get("MAP_CHECKSUM", ""),
    "FIREBOT_LOCATION_ENABLED=%s" % assignment.get("LOCATION_ENABLED", "false"),
    "",
    "FIREBOT_HEARTBEAT_HZ=1",
    "FIREBOT_STATUS_HZ=1",
    "FIREBOT_LOCATION_MAX_HZ=10",
    "",
    "BRIDGE_STUB_MODE=false",
    "FIREBOT_FEEDBACK_TIMEOUT_SECONDS=3",
    "",
    "FIREBOT_SUPPORTED_COMMANDS=%s" % assignment.get("SUPPORTED_COMMANDS", ""),
    "FIREBOT_SENSORS=",
    "FIREBOT_MEDIA=",
    "FIREBOT_PROTOCOL_VERSION=1.3.0",
    "",
    "FIREBOT_FIELD_TRACE=false",
    "",
]
print("\n".join(lines))
PY
}

generate_runtime_env() {
  local profile_id="${1:-$DEFAULT_PROFILE}"
  [ -f "$PROFILE_DIR/$profile_id.yaml" ] || { echo "ERROR: profile 不存在: $profile_id" >&2; exit 1; }
  python3 "$ROS1_DIR/profile-render.py" runtime "$PROFILE_DIR/$profile_id.yaml" > "$FIREBOT_ETC/runtime.env"
  chmod 644 "$FIREBOT_ETC/runtime.env"
}

# ================= 车端 =================
cmd_vehicle() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    enroll)
      # Vehicle Edge canonical：Enrollment 输出到 Edge Home（config/identity、secrets/mqtt.env 等）。
      # 合同不变；实现唯一 source of truth = vehicle-edge/lifecycle/enroll.sh。
      # cutover 门（P0-2）在 enroll.sh 内：Bridge/Edge active → REJECTED，token 零消费。
      local did="${1:-}"
      [ -n "$did" ] || { echo "用法: firebotctl vehicle enroll <DEVICE_ID> --token <TOKEN>" >&2; exit 1; }
      require_root
      bash "$ROS1_DIR/vehicle-edge/lifecycle/enroll.sh" "$@" ;;

    install)
      # LEGACY / FULL VEHICLE INSTALL — NOT FOR READONLY CONNECTIVITY MIGRATION。
      # 真实 R002 通信迁移必须改用 firebotctl vehicle edge-install（只装通信层，不碰 ROS workspace）。
      local sha=""; while [ $# -gt 0 ]; do case "$1" in --sha) sha="$2"; shift 2;; *) shift;; esac; done
      require_sha "$sha"
      # P0-3 cutover 事务门：install ≠ start；Bridge 必须 inactive 才能进入 release_sync/安装。
      # fail-closed：禁止进入 release_sync/vehicle-install.sh/catkin_make。
      if bridge_running; then
        echo "VEHICLE_INSTALL=REJECTED"
        echo "BRIDGE_ACTIVE_BEFORE_INSTALL"
        echo "原因：firebot-bridge 仍在运行；正式迁移路径必须先 migration-stop-legacy。" >&2
        exit 1
      fi
      release_sync "$sha"
      require_root
      FIREBOT_REQUIRE_SHA="$sha" bash "$ROS1_DIR/vehicle-install.sh" all
      FIREBOT_REQUIRE_SHA="$sha" bash "$ROS1_DIR/vehicle-install.sh" verify
      echo "CONTROL_ENABLED=NO"
      ;;
    verify)
      # fail-closed：期望 SHA 来自 release.env 或已安装 APPROVED_RUNTIME，绝不吞错。
      local expect=""
      expect="$(grep -E '^FINAL_SHA=' "$FIREBOT_ETC/release.env" 2>/dev/null | cut -d= -f2- || true)"
      if [ -z "$expect" ]; then
        expect="$(cat /opt/firebot/vehicle-bridge/APPROVED_RUNTIME.txt 2>/dev/null || true)"
      fi
      if [ -z "$expect" ]; then
        echo "VEHICLE_VERIFY=FAIL（无 release.env 且 Bridge 未安装）" >&2
        exit 1
      fi
      if ! FIREBOT_REQUIRE_SHA="$expect" bash "$ROS1_DIR/vehicle-install.sh" verify; then
        echo "VEHICLE_VERIFY=FAIL（APPROVED_RUNTIME 与期望 SHA 不一致）" >&2
        exit 1
      fi
      # P0-C 只读安全门：enabled 之外还必须 active 门（enabled/active/activating/reloading 均 FAIL）。
      local ctl_enabled ctl_active gate_fail=0
      ctl_enabled="$("$SYSTEMCTL" is-enabled firebot-control 2>/dev/null || echo disabled)"
      ctl_active="$("$SYSTEMCTL" is-active firebot-control 2>/dev/null || echo inactive)"
      case "$ctl_enabled" in enabled) gate_fail=1 ;; esac
      case "$ctl_active" in active|activating|reloading) gate_fail=1 ;; esac
      echo "DEVICE_ID=$(read_device_id)"
      echo "PROFILE_ID=$(grep -E '^PROFILE_ID=' "$DEVICE_ENV" 2>/dev/null | cut -d= -f2- || echo UNKNOWN)"
      echo "SOURCE_SHA=$expect"
      echo "CONTROL_ENABLED=$ctl_enabled"
      echo "CONTROL_ACTIVE=$ctl_active"
      if [ "$gate_fail" -ne 0 ]; then
        echo "READONLY_SAFETY_GATE=FAIL"
        echo "VEHICLE_VERIFY=FAIL（firebot-control enabled/active/activating/reloading 只读铁律违反）" >&2
        exit 1
      fi
      echo "READONLY_SAFETY_GATE=PASS"
      echo "VEHICLE_VERIFY=PASS"
      ;;
    status)
      bash "$ROS1_DIR/vehicle-runtime.sh" status ;;
    start)
      local what="${1:-}"; case "$what" in
        base) bash "$ROS1_DIR/vehicle-runtime.sh" ros-base ;;
        navigation) bash "$ROS1_DIR/vehicle-runtime.sh" navigation ;;
        control) bash "$ROS1_DIR/vehicle-runtime.sh" control-start ;;
        *) echo "用法: firebotctl vehicle start base|navigation|control" >&2; exit 1 ;;
      esac ;;
    stop)
      [ "${1:-}" = "control" ] || { echo "用法: firebotctl vehicle stop control" >&2; exit 1; }
      bash "$ROS1_DIR/vehicle-runtime.sh" control-stop ;;
    capability)
      local level="${1:-}"
      case "$level" in
        stop-only) set_capability "stop-only" ;;
        patrol) set_capability "patrol" ;;
        *) echo "用法: firebotctl vehicle capability stop-only|patrol" >&2; exit 1 ;;
      esac ;;
    location)
      [ "${1:-}" = "enable" ] || { echo "用法: firebotctl vehicle location enable" >&2; exit 1; }
      enable_location ;;
    media-secret)
      [ "${1:-}" = "check" ] || { echo "用法: firebotctl vehicle media-secret check" >&2; exit 1; }
      check_media_secret ;;
    readonly-preflight)
      # 真实车辆只读接入前置检查（P0-D）：bootstrap（未 enroll）/ enrolled（已 enroll）。
      # 不得 MQTT publish、不得使用生产 credential 登录（MQTT 仅 TLS 握手）。
      # 实现唯一 source of truth = vehicle-edge/lifecycle/readonly-preflight.sh。
      bash "$ROS1_DIR/vehicle-edge/lifecycle/readonly-preflight.sh" "$@" ;;
    readonly-start)
      # 现场唯一允许启动 Vehicle Edge 的正式入口（P0-E）：只 enable/start
      # firebot-vehicle-edge，绝不触碰 firebot-control/roscore/base/navigation/move_base/cmd_vel。
      require_root
      bash "$ROS1_DIR/vehicle-edge/lifecycle/readonly-start.sh" "$@" ;;
    migration-stop-legacy)
      # 跨 Broker 迁移正式 cutover 切换点（P0-1）：只 disable --now firebot-bridge。
      # Control active/enabled → REJECTED/CONTROL_NOT_SAFE（不自动处理）。
      # 实现唯一 source of truth = vehicle-edge/lifecycle/migration-stop-legacy.sh。
      require_root
      bash "$ROS1_DIR/vehicle-edge/lifecycle/migration-stop-legacy.sh" "$@" ;;
    edge-init)
      # Vehicle Edge 目录与权限初始化（显式 --runtime-user；禁止 id -un 自动猜）。
      require_root
      bash "$ROS1_DIR/vehicle-edge/lifecycle/edge-init.sh" "$@" ;;
    edge-install)
      # 通信专用安装（只装 Vehicle Edge release + systemd unit + wrappers；
      # 绝不触碰 ROS workspace/Control/catkin_make）。
      local esha=""; while [ $# -gt 0 ]; do case "$1" in --sha) esha="$2"; shift 2;; *) shift;; esac; done
      require_sha "$esha"
      # exact SHA：edge-install 要求 HEAD == SHA（release 组装来源可证明）
      local ehead; ehead="$(git -C "$REPO_DIR" rev-parse HEAD)"
      if [ "$ehead" != "$esha" ]; then
        echo "EDGE_INSTALL=REJECTED"
        echo "HEAD_SHA_MISMATCH"
        echo "原因：git HEAD($ehead) != --sha($esha)；先 checkout exact SHA。" >&2
        exit 1
      fi
      require_root
      FIREBOT_REQUIRE_SHA="$esha" bash "$ROS1_DIR/vehicle-edge/lifecycle/edge-install.sh" "$REPO_DIR" ;;
    edge-verify)
      # 验证当前 release/manifest/权限模型（ownership+mode）/service inactive（安装≠启动）。
      local vsha=""; while [ $# -gt 0 ]; do case "$1" in --sha) vsha="$2"; shift 2;; *) shift;; esac; done
      require_sha "$vsha"
      FIREBOT_REQUIRE_SHA="$vsha" bash "$ROS1_DIR/vehicle-edge/lifecycle/edge-verify.sh" "$@" ;;
    edge-backup-legacy)
      # Stage A legacy 备份统一进入 Edge Home backups/legacy/<UTC>/（root:root 0700）。
      # 零运行影响：不 stop/restart/reload/disable 任何服务、不改 Tailscale、不输出 secret。
      require_root
      bash "$ROS1_DIR/vehicle-edge/lifecycle/edge-backup-legacy.sh" "$@" ;;
    profile-sync)
      local did; did="$(read_device_id)"
      local pid; pid="$(grep -E '^PROFILE_ID=' "$DEVICE_ENV" 2>/dev/null | cut -d= -f2- || echo "$DEFAULT_PROFILE")"
      [ -n "$did" ] || { echo "ERROR: 先 enroll" >&2; exit 1; }
      do_profile_sync "$did" "$pid" || exit 1
      echo "PROFILE_SYNC=PASS" ;;
    support-bundle)
      vehicle_support_bundle ;;
    rollback)
      bash "$ROS1_DIR/vehicle-install.sh" rollback ;;
    upgrade)
      local sha=""; while [ $# -gt 0 ]; do case "$1" in --sha) sha="$2"; shift 2;; *) shift;; esac; done
      require_sha "$sha"; release_sync "$sha"; require_root
      FIREBOT_REQUIRE_SHA="$sha" bash "$ROS1_DIR/vehicle-install.sh" all
      FIREBOT_REQUIRE_SHA="$sha" bash "$ROS1_DIR/vehicle-install.sh" verify ;;
    *)
      echo "firebotctl vehicle <enroll|install|verify|status|start|stop|capability|location|profile-sync|support-bundle|rollback|upgrade|readonly-preflight|readonly-start|migration-stop-legacy|edge-init|edge-install|edge-verify|edge-backup-legacy>" >&2; exit 1 ;;
  esac
}

# ---- 服务器权威 assignment 同步（GET → 写本地缓存 → 重生成 runtime/bridge）----
do_profile_sync() {
  local did="$1" pid="$2"
  local resp
  resp="$(server_get_assignment "$did")"
  [ -n "$resp" ] || { echo "PROFILE_SYNC=FAIL（无法请求服务器 assignment）" >&2; return 1; }
  echo "$resp" | python3 -c '
import json, os, sys
d = json.load(sys.stdin)
old = {}
p = os.environ.get("FIREBOT_ETC", "/etc/firebot") + "/assignment.env"
if os.path.exists(p):
    for line in open(p, encoding="utf-8"):
        line = line.strip()
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            old[k] = v
out = [
    "MQTT_HOST=%s" % old.get("MQTT_HOST", ""),
    "MQTT_PORT=%s" % old.get("MQTT_PORT", "8883"),
    "SITE_CODE=%s" % d.get("site_code", ""),
    "MAP_CODE=%s" % d.get("map_code", ""),
    "MAP_VERSION=%s" % d.get("map_version", ""),
    "MAP_CHECKSUM=%s" % d.get("map_checksum", ""),
    "LOCATION_ENABLED=%s" % ("true" if d.get("location_enabled") else "false"),
    "SUPPORTED_COMMANDS=%s" % ",".join(d.get("supported_commands", [])),
    "ASSIGNMENT_REVISION=%s" % d.get("assignment_revision", 0),
]
open(p, "w").write("\n".join(out) + "\n")
os.chmod(p, 0o644)
print(d.get("assignment_revision", 0))
'
  generate_bridge_env "$did" "$pid" > "$BRIDGE_ENV"
  generate_runtime_env "$pid"
}

# ---- 受控能力提升（服务器权威：GET 证据 → PUT capability → profile-sync → 重启 → 新 boot）----
set_capability() {
  local level="$1"
  local commands
  if [ "$level" = "patrol" ]; then
    commands="stop_motion,patrol"
  else
    commands="stop_motion"
  fi
  require_root
  local did; did="$(read_device_id)"
  local pid; pid="$(grep -E '^PROFILE_ID=' "$DEVICE_ENV" 2>/dev/null | cut -d= -f2- || echo "$DEFAULT_PROFILE")"
  [ -n "$did" ] || { echo "ERROR: 先 enroll" >&2; exit 1; }
  if [ "$level" = "patrol" ]; then
    # patrol 必须从服务器读取 STOP 现场验证证据（不再读本地人工 assignment.env）
    local verified
    verified="$(server_get_assignment "$did" | python3 -c 'import json,sys; print("true" if json.load(sys.stdin).get("stop_field_verified") else "false")' 2>/dev/null || echo false)"
    [ "$verified" = "true" ] || {
      echo "PATROL_CAPABILITY_PROMOTION=REJECTED（服务器无 STOP field evidence，禁止 patrol）" >&2
      exit 1
    }
  fi
  # 请求服务器修改 SUPPORTED_COMMANDS（revision+1）
  local cmds_json
  cmds_json="$(printf '%s' "$commands" | python3 -c 'import json,sys; print(json.dumps([c for c in sys.stdin.read().split(",") if c]))')"
  local put_resp
  put_resp="$(server_put_assignment "$did" "capability" "{\"commands\": $cmds_json}")"
  [ -n "$put_resp" ] || { echo "CAPABILITY_PROMOTION=FAIL（服务器拒绝/不可达）" >&2; exit 1; }
  do_profile_sync "$did" "$pid" || exit 1
  # restart 必须成功，禁止 || true 吞错
  local old_boot new_boot=""
  old_boot="$(read_boot_id)"
  systemctl restart firebot-bridge
  for _ in $(seq 1 30); do
    new_boot="$(read_boot_id)"
    [ -n "$new_boot" ] && [ "$new_boot" != "$old_boot" ] && break
    sleep 2
  done
  if [ -z "$new_boot" ] || [ "$new_boot" = "$old_boot" ]; then
    echo "CAPABILITY_PROMOTION=FAIL（Bridge 未产生新 boot_id）" >&2
    exit 1
  fi
  for _ in $(seq 1 30); do
    [ "$(status_bool mqtt_connected)" = "true" ] && break
    sleep 2
  done
  if [ "$(status_bool mqtt_connected)" != "true" ]; then
    echo "CAPABILITY_PROMOTION=FAIL（MQTT 未连接）" >&2
    exit 1
  fi
  echo "CAPABILITY_PROMOTION=PASS level=$level"
  echo "NEW_BOOT_ID=$new_boot"
}

enable_location() {
  require_root
  local did; did="$(read_device_id)"
  local pid; pid="$(grep -E '^PROFILE_ID=' "$DEVICE_ENV" 2>/dev/null | cut -d= -f2- || echo "$DEFAULT_PROFILE")"
  local resp
  resp="$(server_get_assignment "$did")"
  local site map ver ck
  site="$(echo "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("site_code",""))' 2>/dev/null || echo "")"
  map="$(echo "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("map_code",""))' 2>/dev/null || echo "")"
  ver="$(echo "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("map_version",""))' 2>/dev/null || echo "")"
  ck="$(echo "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("map_checksum",""))' 2>/dev/null || echo "")"
  if [ -z "$site" ] || [ -z "$map" ] || [ -z "$ver" ] || [ -z "$ck" ]; then
    echo "LOCATION_ENABLE=REJECTED" >&2
    echo "MAP_IDENTITY_NOT_VERIFIED" >&2
    exit 1
  fi
  local amcl odom
  amcl="$(timeout 3 rostopic echo -n1 /amcl_pose >/dev/null 2>&1 && echo ok || echo missing)"
  odom="$(timeout 3 rostopic echo -n1 /odom >/dev/null 2>&1 && echo ok || echo missing)"
  [ "$amcl" = "ok" ] && [ "$odom" = "ok" ] || {
    echo "LOCATION_ENABLE=REJECTED" >&2
    echo "ROS_SOURCE_NOT_READY amcl=$amcl odom=$odom" >&2
    exit 1
  }
  # 请求服务器设置 desired LOCATION_ENABLED=true（revision+1）
  local put_resp
  put_resp="$(server_put_assignment "$did" "location" '{"enabled": true}')"
  [ -n "$put_resp" ] || { echo "LOCATION_ENABLE=REJECTED（服务器拒绝）" >&2; exit 1; }
  do_profile_sync "$did" "$pid" || exit 1
  systemctl restart firebot-bridge
  echo "LOCATION_PROMOTION=PASS"
}

# ---- 媒体 secret 安全落盘规范（P1：本阶段只建规范/检查入口，不向真实 R001 下发）----
# 车端正式文件：/etc/firebot/media-secret.env（0600 root:root，绝不进 bridge.env/repo/log/报告）
#   未来安全下发内容：
#     FIREBOT_SRT_PUBLISH_TOKEN=<R001 per-vehicle SRT publish token（HMAC 派生）>
#     FIREBOT_SRT_PASSPHRASE=<platform shared SRT encryption passphrase>
#   视频链：真实相机 → RTSP/SDK → 车端 FFmpeg/GStreamer → SRT firebot.youdaozd.com:8890
#           → R001-roof_rgb / R001-roof_thermal（H.264 + yuv420p；视频不塞进 ROS/Bridge）
check_media_secret() {
  local f="/etc/firebot/media-secret.env"
  local errors=0
  if [ ! -f "$f" ]; then
    echo "MEDIA_SECRET=NOT_CONFIGURED（$f 不存在；真实 R001 视频接入前由 OWNER 安全下发）"
    return 0
  fi
  mode="$(stat -c '%a' "$f" 2>/dev/null || echo 0)"
  owner="$(stat -c '%u:%g' "$f" 2>/dev/null || echo '?:?')"
  [ "$mode" = "600" ] || { echo "ERROR: $f 权限必须 600（当前 $mode）" >&2; errors=1; }
  [ "$owner" = "0:0" ] || { echo "ERROR: $f 必须 root:root（当前 $owner）" >&2; errors=1; }
  for key in FIREBOT_SRT_PUBLISH_TOKEN FIREBOT_SRT_PASSPHRASE; do
    if grep -qE "^$key=.+" "$f" 2>/dev/null; then
      echo "MEDIA_SECRET_KEY $key=PRESENT（值不回显）"
    else
      echo "ERROR: $f 缺少非空 $key" >&2
      errors=1
    fi
  done
  [ "$errors" -eq 0 ] && echo "MEDIA_SECRET=READY（值不回显）" || { echo "MEDIA_SECRET=INVALID" >&2; return 1; }
}

# ---- 脱敏 support bundle ----
vehicle_support_bundle() {
  local did; did="$(read_device_id)"
  local ts; ts="$(date -u +%Y%m%d)"
  local out="firebot-support-${did:-unknown}-${ts}.tar.gz"
  local tmp; tmp="$(mktemp -d)"
  {
    echo "vehicle_id=$did"
    echo "sha=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo UNKNOWN)"
    echo "bridge_runtime=$(cat /opt/firebot/vehicle-bridge/APPROVED_RUNTIME.txt 2>/dev/null || echo UNKNOWN)"
    echo "control_runtime=$(cat /home/tl/firerobot_ws/src/firebot_control/APPROVED_RUNTIME.txt 2>/dev/null || echo UNKNOWN)"
    echo "boot_id=$(cat /run/firebot-bridge/status.json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("boot_id",""))' 2>/dev/null || echo UNKNOWN)"
    systemctl is-active firebot-bridge 2>/dev/null || true
    systemctl is-enabled firebot-control 2>/dev/null || true
    rostopic list 2>/dev/null || true
    echo "control_mode=$(timeout 3 rostopic echo -n1 /robot_status 2>/dev/null | grep -oP '(?<=control_mode: )\S+' | head -1 || true)"
    echo "cmd_vel_info=$(rostopic info /cmd_vel 2>/dev/null || true)"
  } > "$tmp/vehicle.txt"
  # 脱敏：绝不打包 secret
  tar czf "$out" -C "$tmp" vehicle.txt
  rm -rf "$tmp"
  echo "SUPPORT_BUNDLE=$out（已脱敏，不含 secret）"
}

# ================= 服务器 =================
cmd_server() {
  local sub="${1:-}"; shift || true
  # 服务器操作依赖 .env.server / docker-compose.server.yml / ./secrets 的相对路径，必须 cd 到仓库根执行。
  (
    cd "$REPO_DIR"
    case "$sub" in
      deploy)
        local sha=""; while [ $# -gt 0 ]; do case "$1" in --sha) sha="$2"; shift 2;; *) shift;; esac; done
        require_sha "$sha"
        release_sync "$sha" server
        TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" preflight
        # 在整个 deploy 开始时就记录 migration_before（供 manifest 使用，避免 migrate 后误记）
        DEPLOY_MIGRATION_BEFORE="$(TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" current-revision)"
        export DEPLOY_MIGRATION_BEFORE
        # 自动 migration：DB revision != 目标 head 时，先真实 pg_dump 备份再 migrate
        if ! TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" migration-needed; then
          TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" backup
          TARGET_SHA="$sha" BACKUP_VERIFIED=1 "$REPO_DIR/scripts/server-deploy.sh" migrate
        fi
        TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" all-app
        TARGET_SHA="$sha" "$REPO_DIR/scripts/server-deploy.sh" verify ;;
      verify) "$REPO_DIR/scripts/server-deploy.sh" verify ;;
      rollback) "$REPO_DIR/scripts/server-deploy.sh" rollback ;;
      support-bundle)
        echo "SERVER_SUPPORT_BUNDLE=见 scripts/server-deploy.sh manifest + docker compose logs" ;;
      *) echo "firebotctl server <deploy|verify|rollback|support-bundle>" >&2; exit 1 ;;
    esac
  )
}

# ================= 舰队 =================
cmd_fleet() {
  local sub="${1:-}"; shift || true
  # fleet-register（U-Dao 生产语义）：复用 canonical onboarding，不操作 ./secrets、不重启 broker。
  (
    cd "$REPO_DIR"
    case "$sub" in
      register)
        local did="${1:-}"
        [ -n "$did" ] || { echo "用法: firebotctl fleet register <DEVICE_ID>" >&2; exit 1; }
        "$SCRIPT_DIR/fleet-register.sh" "$did" ;;
      sites)
        # 只读列出 Site（SITE_CODE/SITE_NAME/ACTIVE/ROBOT_COUNT），无数据库敏感信息。
        "$SCRIPT_DIR/fleet-sites.sh" ;;
      preregister)
        # 建立 Fleet stable identity（enabled=false 只读基线）；绝不生成 credential/token。
        [ -n "${1:-}" ] || { echo "用法: firebotctl fleet preregister <DEVICE_ID> --name <N> --site-code <S>" >&2; exit 1; }
        "$SCRIPT_DIR/fleet-preregister.sh" "$@" ;;
      status)
        echo "FLEET_STATUS=见服务器 Robot/IntegrationProfile（firebotctl server verify）" ;;
      *) echo "firebotctl fleet <register|sites|preregister|status>" >&2; exit 1 ;;
    esac
  )
}

# ================= 入口 =================
print_help() {
  echo "Firebot 现场统一入口（firebotctl）"
  echo ""
  echo "用法："
  echo "  firebotctl vehicle enroll <设备编号> --token <令牌>     车辆注册"
  echo "  firebotctl vehicle install --sha <SHA>                车辆安装"
  echo "  firebotctl vehicle verify                              车辆验收（含只读安全门）"
  echo "  firebotctl vehicle readonly-preflight --phase bootstrap|enrolled  只读前置检查"
  echo "  firebotctl vehicle readonly-start                      只读启动 Bridge（唯一正式入口）"
  echo "  firebotctl vehicle migration-stop-legacy                迁移 cutover：停 legacy Bridge"
  echo "  firebotctl vehicle start base|navigation|control       模块化启动"
  echo "  firebotctl vehicle capability stop-only|patrol         能力提升"
  echo "  firebotctl vehicle location enable                     定位开启"
  echo "  firebotctl vehicle media-secret check                  媒体 secret 落盘规范检查"
  echo "  firebotctl vehicle rollback / support-bundle           回滚 / 诊断包"
  echo "  firebotctl server deploy --sha <SHA> / verify / rollback  服务器部署/验收/回滚"
  echo "  firebotctl fleet sites                                 只读列出 Site"
  echo "  firebotctl fleet preregister <设备编号> --name <名> --site-code <站点>  预登记"
  echo "  firebotctl fleet register <设备编号>                    设备签发（需已预登记）"
  echo ""
  echo "详细见 docs/部署运维/车端部署与实车接口.md"
}

case "${1:-}" in
  vehicle) shift; cmd_vehicle "$@" ;;
  server) shift; cmd_server "$@" ;;
  fleet) shift; cmd_fleet "$@" ;;
  -h|--help|help) print_help ;;
  __pathcheck__)
    # 内部测试用：验证 REPO_DIR 正确定位到 ROBOT-Web 根（而非 integration/）。
    [ -f "$REPO_DIR/scripts/server-deploy.sh" ] || { echo "MISSING scripts/server-deploy.sh（REPO_DIR=$REPO_DIR）" >&2; exit 1; }
    [ -f "$REPO_DIR/docker-compose.server.yml" ] || { echo "MISSING docker-compose.server.yml" >&2; exit 1; }
    [ -f "$ROS1_DIR/vehicle-install.sh" ] || { echo "MISSING vehicle-install.sh" >&2; exit 1; }
    echo "REPO_DIR=$REPO_DIR"
    echo "PATHCHECK=PASS"
    ;;
  *) echo "用法: firebotctl <vehicle|server|fleet> ...（firebotctl --help 查看）" >&2; exit 1 ;;
esac
