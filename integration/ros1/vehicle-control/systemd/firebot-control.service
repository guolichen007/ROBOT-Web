[Unit]
Description=Firebot vehicle control adapter (PATROL_START / STOP_MOTION)
# 默认 disabled：只有 ROS master ready + 下游 gate ready + 现场负责人明确执行后
# 才允许 `systemctl start firebot-control`。安装绝不自动 enable --now。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 车型参数来自 /etc/firebot/runtime.env（Fleet Profile 生成），不硬编码 workspace/adapter。
ExecStart=/bin/bash -lc 'set -e; [ -f /etc/firebot/runtime.env ] && . /etc/firebot/runtime.env; ROS_DISTRO=${ROS_DISTRO:-noetic}; ROS_WORKSPACE=${ROS_WORKSPACE:-/home/tl/firerobot_ws}; source /opt/ros/$ROS_DISTRO/setup.bash; source $ROS_WORKSPACE/devel/setup.bash; exec rosrun firebot_control ${CONTROL_ADAPTER:-firebot_control_adapter.py}'
Restart=no
# 运行用户由 install.sh 根据 FIREBOT_CONTROL_USER 生成（默认当前用户），不硬编码 tl。
User=@CONTROL_USER@

[Install]
WantedBy=multi-user.target
