# Firebot 同型车媒体 Hardware Profile（firebot_ros1_standard_v1；R001/R002/后续同型车共用）
# 只含非敏感硬件/源事实；车辆身份、SRT endpoint、凭证不在此文件（见 config/media.env 与 media/secrets/）。
# 安装：firebotctl vehicle media install 落位为 <EDGE_HOME>/config/media-hardware.env（root 0644）。
#
# 视频源合同（车端 web_nav INTERFACE.md §六 / README 模式 G）：
#   web_video_server :8080  http://<车端>:8080/stream?topic=<话题>&type=mjpeg
#   RGB      /camera/color/image_raw  —— realsense2_camera（单目彩色；非 camera_sdk 双目拼接）
#   thermal  /thermal/image           —— svusb_thermal（rgb8 伪彩 640x480@25，SDK 按 device_index 打开）
# 默认 provider=http_mjpeg：相机只由 ROS 驱动采集一次，局域网 web_nav 与云端发布器都是
# web_video_server 的消费者，绝不与 ROS 争用 USB 设备。实际分辨率/帧率以现场只读取证回填。

FIREBOT_MEDIA_PROFILE=firebot_ros1_standard_v1
FIREBOT_MEDIA_CAMERAS=roof_rgb,roof_thermal
FIREBOT_MEDIA_ENCODER=auto
FIREBOT_MEDIA_SRT_LATENCY_MS=200

FIREBOT_MEDIA_ROOF_RGB_PROVIDER=http_mjpeg
FIREBOT_MEDIA_ROOF_RGB_HTTP_URL=http://127.0.0.1:8080/stream?topic=/camera/color/image_raw&type=mjpeg&quality=80
FIREBOT_MEDIA_ROOF_RGB_FPS=15
FIREBOT_MEDIA_ROOF_RGB_BITRATE_KBPS=1500
FIREBOT_MEDIA_ROOF_RGB_GOP_SECONDS=2

FIREBOT_MEDIA_ROOF_THERMAL_PROVIDER=http_mjpeg
FIREBOT_MEDIA_ROOF_THERMAL_HTTP_URL=http://127.0.0.1:8080/stream?topic=/thermal/image&type=mjpeg&quality=80
FIREBOT_MEDIA_ROOF_THERMAL_FPS=15
FIREBOT_MEDIA_ROOF_THERMAL_BITRATE_KBPS=800
FIREBOT_MEDIA_ROOF_THERMAL_GOP_SECONDS=2

# 可选 provider（非同型车默认；启用前确认车内无 ROS 节点持有同一设备）：
# FIREBOT_MEDIA_ROOF_THERMAL_PROVIDER=v4l2
# FIREBOT_MEDIA_ROOF_THERMAL_DEVICE=/dev/v4l/by-id/usb-<vendor>_<model>_<serial>-video-index0
# FIREBOT_MEDIA_ROOF_THERMAL_INPUT_FORMAT=yuyv422
# FIREBOT_MEDIA_ROOF_RGB_PROVIDER=rtsp     # URL 含凭证 → media/secrets/rtsp_roof_rgb.url（0600）
