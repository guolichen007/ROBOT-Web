APP_ENV=dev
APP_NAME=Firebot Cloud Control Platform
DATABASE_URL=postgresql+psycopg://firebot:firebot_dev@postgres:5432/firebot
POSTGRES_DB=firebot
POSTGRES_USER=firebot
POSTGRES_PASSWORD=firebot_dev
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_ALLOW_ANONYMOUS=true
JWT_SECRET=GENERATED_BY_DEV_SCRIPT
REFRESH_SECRET=GENERATED_BY_DEV_SCRIPT
CSRF_SECRET=GENERATED_BY_DEV_SCRIPT
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=GENERATED_BY_DEV_SCRIPT
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://nginx
PUBLIC_BASE_URL=http://localhost:8080
SEED_DEMO=true
MOCK_ENABLED=true
LOG_LEVEL=INFO
ASSET_ROOT=/data/assets
TELEMETRY_RETENTION_DAYS=30
SENSOR_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
MANUAL_LEASE_TTL_SECONDS=5
COMMAND_ACK_TIMEOUT_SECONDS=3
EVENT_STREAM_MAXLEN=10000
ROBOT_STALE_SECONDS=3
ROBOT_OFFLINE_SECONDS=10
ROS_COMPAT_MODE=false
SINGLE_ROBOT_MODE=true
SINGLE_ROBOT_INTERNAL_ID=R001
ROS_COMPAT_EXPECTED_EXTERNAL_ID=
ROS_COMPAT_RAW_MAX_BYTES=16384
ROS_COMPAT_RAW_RETENTION_SECONDS=900
ROS_COMPAT_STALE_SECONDS=8
ROS_COMPAT_OFFLINE_SECONDS=15
