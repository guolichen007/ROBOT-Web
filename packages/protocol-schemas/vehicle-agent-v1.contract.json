{
  "version": "vehicle-agent-v1",
  "topics": {
    "cmd": {
      "qos": 1,
      "retain": false
    },
    "ack": {
      "qos": 1,
      "retain": false
    },
    "status": {
      "qos": 1,
      "retain": true
    },
    "telemetry": {
      "qos": 0,
      "retain": false
    },
    "availability": {
      "qos": 1,
      "retain": true
    },
    "event": {
      "qos": 1,
      "retain": false
    }
  },
  "models": {
    "WireCommand": {
      "additionalProperties": false,
      "properties": {
        "msg_id": {
          "format": "uuid",
          "title": "Msg Id",
          "type": "string"
        },
        "command": {
          "enum": [
            "start",
            "close",
            "patrol",
            "stop_patrol",
            "resume_patrol",
            "homing",
            "navigate",
            "stop_navigate",
            "ping",
            "get_status",
            "get_telemetry"
          ],
          "title": "Command",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "msg_id",
        "command",
        "ts"
      ],
      "title": "WireCommand",
      "type": "object"
    },
    "Ack": {
      "additionalProperties": false,
      "properties": {
        "msg_id": {
          "format": "uuid",
          "title": "Msg Id",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "msg_id",
        "success",
        "code",
        "ts"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Status": {
      "$defs": {
        "AgentTask": {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "idle",
                "patrol",
                "homing",
                "spot"
              ],
              "title": "State",
              "type": "string"
            },
            "patrol_next": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Patrol Next"
            },
            "patrol_count": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Patrol Count"
            },
            "patrol_paused": {
              "default": false,
              "title": "Patrol Paused",
              "type": "boolean"
            }
          },
          "required": [
            "state"
          ],
          "title": "AgentTask",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "online": {
          "title": "Online",
          "type": "boolean"
        },
        "programs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Programs",
          "type": "object"
        },
        "task": {
          "$ref": "#/$defs/AgentTask"
        },
        "ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts"
        }
      },
      "required": [
        "online",
        "task"
      ],
      "title": "Status",
      "type": "object"
    },
