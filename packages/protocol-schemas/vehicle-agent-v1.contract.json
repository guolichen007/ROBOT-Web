    "CanonicalCommand": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "vehicle-agent-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "const": "command",
          "title": "Type",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "vehicle_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Vehicle Id",
          "type": "string"
        },
        "target_boot_id": {
          "format": "uuid",
          "title": "Target Boot Id",
          "type": "string"
        },
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "lease_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Id"
        },
        "control_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Session Id"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "ttl_ms": {
          "exclusiveMinimum": 0,
          "maximum": 240000,
          "title": "Ttl Ms",
          "type": "integer"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "source": {
          "const": "WEB",
          "title": "Source",
          "type": "string"
        },
        "operator_id": {
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "cmd": {
          "title": "Cmd",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
